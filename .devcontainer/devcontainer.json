{
  "name": "Trapezoid Angle Calculator",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  
  // 自動將 Gradio 的 Port 7860 轉發並設為 Public
  "forwardPorts": [7860],
  "portsAttributes": {
    "7860": {
      "label": "Gradio App",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    }
  },

  // 環境初始化：自動安裝最新版 Gradio 與周邊套件
  "postCreateCommand": "pip install --upgrade pip && pip install gradio pandas numpy matplotlib",

  // VS Code 設定：確保編輯器與終端機自動鎖定 Python 3.12 環境
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
